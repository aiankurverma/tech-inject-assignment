{
  "name": "Password Input",
  "slug": "password-input",
  "description": "Password field with an accessible show/hide toggle and an optional four-segment strength meter.",
  "category": "Forms",
  "version": "1.0.0",
  "access": "free",
  "dependencies": ["lucide-react"],
  "files": ["components/crm/password-input.tsx"],
  "examples": [
    {
      "title": "With strength meter",
      "file": "password-input-1.tsx"
    }
  ],
  "props": [
    {
      "name": "showStrength",
      "type": "boolean",
      "description": "Show the strength meter",
      "default": "false",
      "required": false
    },
    {
      "name": "getStrength",
      "type": "(value: string) => 0 | 1 | 2 | 3 | 4",
      "description": "Custom scorer",
      "default": "scorePassword",
      "required": false
    },
    {
      "name": "invalid",
      "type": "boolean",
      "description": "Red error border",
      "default": "false",
      "required": false
    },
    {
      "name": "autoComplete",
      "type": "string",
      "description": "Use \"new-password\" on sign-up forms",
      "default": "\"current-password\"",
      "required": false
    }
  ],
  "usage": "Accepts all native input props. scorePassword is exported for server-side parity checks."
}
