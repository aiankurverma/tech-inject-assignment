{
  "name": "Health Overview",
  "slug": "health-overview",
  "description": "Customer health overview: ARR-weighted band distribution with click-to-filter, ARR at risk, renewing-soon card, score movers and a searchable, sortable account list with drivers and owners.",
  "category": "Dashboards",
  "version": "1.0.0",
  "access": "free",
  "dependencies": ["lucide-react"],
  "files": [
    "components/crm/health-overview.tsx",
    "components/crm/avatar.tsx",
    "components/crm/search-input.tsx",
    "components/crm/kbd.tsx"
  ],
  "examples": [
    {
      "title": "Book of business",
      "file": "health-overview-1.tsx"
    }
  ],
  "props": [
    {
      "name": "accounts",
      "type": "HealthAccount[]",
      "description": "{ id, name, arr, score, previousScore?, renewalDate?, owner?, signals? }",
      "required": true
    },
    {
      "name": "thresholds",
      "type": "{ healthy, neutral, atRisk }",
      "description": "Lower score bound of each band",
      "default": "{ healthy: 75, neutral: 55, atRisk: 35 }",
      "required": false
    },
    {
      "name": "renewalWindowDays",
      "type": "number",
      "description": "Window for the renewing-soon flag",
      "default": "90",
      "required": false
    },
    {
      "name": "asOf",
      "type": "string",
      "description": "Reference date",
      "required": false
    },
    {
      "name": "currency",
      "type": "string",
      "description": "ISO currency code",
      "default": "\"USD\"",
      "required": false
    },
    {
      "name": "onAccountSelect",
      "type": "(id) => void",
      "description": "Row click",
      "required": false
    },
    {
      "name": "className",
      "type": "string",
      "description": "Extra classes on the root",
      "required": false
    }
  ],
  "usage": "healthBand(score, thresholds) is exported."
}
