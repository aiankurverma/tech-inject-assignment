{
  "name": "Forgot Password",
  "slug": "forgot-password",
  "description": "Request a reset link; confirmation screen with masked email, deliverability tips, resend cooldown and a resend cap that points to support.",
  "category": "Auth and onboarding",
  "version": "1.0.0",
  "access": "free",
  "dependencies": ["@radix-ui/react-slot", "lucide-react"],
  "files": [
    "components/crm/forgot-password.tsx",
    "components/crm/alert.tsx",
    "components/crm/button.tsx",
    "components/crm/input.tsx"
  ],
  "examples": [
    {
      "title": "Reset link with resend cooldown",
      "file": "forgot-password-1.tsx"
    }
  ],
  "props": [
    {
      "name": "onSubmit",
      "type": "(email: string) => Promise<string | void>",
      "description": "Send the reset email",
      "required": true
    },
    {
      "name": "onBack",
      "type": "() => void",
      "description": "Back to sign in",
      "required": false
    },
    {
      "name": "defaultEmail",
      "type": "string",
      "description": "Prefilled email",
      "required": false
    },
    {
      "name": "resendCooldown",
      "type": "number",
      "description": "Seconds between resends",
      "required": false,
      "default": "60"
    },
    {
      "name": "maxResends",
      "type": "number",
      "description": "Resends before showing the support prompt",
      "required": false,
      "default": "3"
    },
    {
      "name": "linkValidMinutes",
      "type": "number",
      "description": "Link lifetime shown in copy",
      "required": false,
      "default": "30"
    },
    {
      "name": "supportHref",
      "type": "string",
      "description": "Support link",
      "required": false,
      "default": "\"#\""
    }
  ],
  "usage": "The confirmation never confirms whether the account exists (prevents account enumeration)."
}
