{
  "name": "Reset Password",
  "slug": "reset-password",
  "description": "Set a new password from a reset link: policy checklist, strength meter, confirm match, reused-password check, token expiry countdown and sign-out-everywhere option.",
  "category": "Auth and onboarding",
  "version": "1.0.0",
  "access": "free",
  "dependencies": ["@radix-ui/react-checkbox", "@radix-ui/react-slot", "lucide-react"],
  "files": [
    "components/crm/reset-password.tsx",
    "components/crm/alert.tsx",
    "components/crm/button.tsx",
    "components/crm/checkbox.tsx",
    "components/crm/input.tsx",
    "components/crm/password-input.tsx"
  ],
  "examples": [
    {
      "title": "Reset with expiry countdown",
      "file": "reset-password-1.tsx"
    }
  ],
  "props": [
    {
      "name": "email",
      "type": "string",
      "description": "Account email; passwords containing it are rejected",
      "required": true
    },
    {
      "name": "onSubmit",
      "type": "(password, { signOutOtherSessions }) => Promise<string | void>",
      "description": "Save the password",
      "required": true
    },
    {
      "name": "expiresAt",
      "type": "Date | string | number",
      "description": "Token expiry; shows countdown and expired state",
      "required": false
    },
    {
      "name": "policy",
      "type": "{ minLength?; requireUpper?; requireNumber?; requireSymbol? }",
      "description": "Password policy",
      "required": false,
      "default": "{ minLength: 12, all true }"
    },
    {
      "name": "isReused",
      "type": "(password) => Promise<boolean> | boolean",
      "description": "Server check against recent passwords",
      "required": false
    },
    {
      "name": "onRequestNewLink",
      "type": "() => void",
      "description": "Action on the expired state",
      "required": false
    },
    {
      "name": "onContinue",
      "type": "() => void",
      "description": "Action on the success state",
      "required": false
    }
  ],
  "usage": "Mount on the /reset?token= route; pass the token expiry from your API."
}
