{
  "name": "Subscription Status",
  "slug": "subscription-status",
  "description": "Subscription lifecycle pill with a date-aware line for trial end, renewal, grace period, scheduled cancellation and suspension.",
  "category": "Commerce and billing",
  "version": "1.0.0",
  "access": "free",
  "dependencies": [],
  "files": ["components/crm/subscription-status.tsx"],
  "examples": [
    {
      "title": "Account list with filter",
      "file": "subscription-status-1.tsx"
    }
  ],
  "props": [
    {
      "name": "status",
      "type": "SubscriptionState",
      "description": "trialing | active | past_due | unpaid | paused | canceled | incomplete",
      "required": true
    },
    {
      "name": "periodEnd",
      "type": "string",
      "description": "ISO date relevant to the status",
      "required": false
    },
    {
      "name": "cancelAtPeriodEnd",
      "type": "boolean",
      "description": "Active but scheduled to cancel",
      "default": "false",
      "required": false
    },
    {
      "name": "retryCount",
      "type": "number",
      "description": "Failed payment retries (past_due)",
      "required": false
    },
    {
      "name": "variant",
      "type": "\"badge\" | \"detail\"",
      "description": "Pill only or pill + detail",
      "default": "\"detail\"",
      "required": false
    },
    {
      "name": "action",
      "type": "ReactNode",
      "description": "Trailing action, e.g. Update card",
      "required": false
    },
    {
      "name": "now",
      "type": "Date",
      "description": "Clock override",
      "required": false
    },
    {
      "name": "locale",
      "type": "string",
      "description": "BCP 47 locale",
      "required": false
    }
  ],
  "usage": "Urgent states (past due, unpaid, trial ending within 3 days) pulse and colour the detail."
}
