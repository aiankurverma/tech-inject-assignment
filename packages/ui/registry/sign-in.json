{
  "name": "Sign In",
  "slug": "sign-in",
  "description": "Email + password sign-in with SSO buttons, magic-link mode, caps-lock hint, failed-attempt counter and timed lockout.",
  "category": "Auth and onboarding",
  "version": "1.0.0",
  "access": "free",
  "dependencies": ["@radix-ui/react-checkbox", "@radix-ui/react-slot", "lucide-react"],
  "files": [
    "components/crm/sign-in.tsx",
    "components/crm/alert.tsx",
    "components/crm/button.tsx",
    "components/crm/checkbox.tsx",
    "components/crm/input.tsx",
    "components/crm/password-input.tsx"
  ],
  "examples": [
    {
      "title": "Northwind sign-in with SSO and lockout",
      "file": "sign-in-1.tsx"
    }
  ],
  "props": [
    {
      "name": "onSubmit",
      "type": "(values) => Promise<string | void>",
      "description": "Sign in; return a string or throw to show an error and count a failed attempt",
      "required": true
    },
    {
      "name": "onMagicLink",
      "type": "(email) => Promise<string | void>",
      "description": "Enables the Email me a link mode",
      "required": false
    },
    {
      "name": "providers",
      "type": "{ id; label; icon? }[]",
      "description": "SSO buttons above the form",
      "required": false,
      "default": "[]"
    },
    {
      "name": "onProviderClick",
      "type": "(id: string) => void",
      "description": "SSO button handler",
      "required": false
    },
    {
      "name": "onForgotPassword",
      "type": "(email: string) => void",
      "description": "Shows the Forgot password link",
      "required": false
    },
    {
      "name": "onSignUp",
      "type": "() => void",
      "description": "Shows the Create an account link",
      "required": false
    },
    {
      "name": "maxAttempts",
      "type": "number",
      "description": "Failed attempts before lockout",
      "required": false,
      "default": "5"
    },
    {
      "name": "lockoutSeconds",
      "type": "number",
      "description": "Lockout length",
      "required": false,
      "default": "30"
    },
    {
      "name": "defaultEmail",
      "type": "string",
      "description": "Prefilled email",
      "required": false
    },
    {
      "name": "title / description / logo",
      "type": "ReactNode",
      "description": "Header content",
      "required": false
    }
  ],
  "usage": "Return a string from onSubmit for wrong credentials; the component tracks attempts and locks itself."
}
