{
  "name": "Progress",
  "slug": "progress",
  "description": "Linear progress bar (determinate or indeterminate) and a circular ProgressRing, in primary/success/warning/danger tones.",
  "category": "Feedback",
  "version": "1.0.0",
  "access": "free",
  "dependencies": [],
  "files": ["components/crm/progress.tsx"],
  "examples": [
    {
      "title": "Bars and rings",
      "file": "progress-1.tsx"
    }
  ],
  "props": [
    {
      "name": "value",
      "type": "number",
      "description": "Current value; omit for indeterminate",
      "required": false
    },
    {
      "name": "max",
      "type": "number",
      "description": "Maximum",
      "default": "100",
      "required": false
    },
    {
      "name": "tone",
      "type": "\"primary\" | \"success\" | \"warning\" | \"danger\"",
      "description": "Fill colour",
      "default": "\"primary\"",
      "required": false
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\"",
      "description": "Bar height",
      "default": "\"md\"",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "description": "Caption and accessible name",
      "required": false
    },
    {
      "name": "showValue",
      "type": "boolean",
      "description": "Show percentage",
      "default": "false",
      "required": false
    },
    {
      "name": "size (ProgressRing)",
      "type": "number",
      "description": "Diameter in px",
      "default": "56",
      "required": false
    },
    {
      "name": "label (ProgressRing)",
      "type": "string",
      "description": "Accessible name",
      "required": true
    }
  ],
  "usage": ""
}
