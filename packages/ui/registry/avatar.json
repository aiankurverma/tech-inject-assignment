{
  "name": "Avatar",
  "slug": "avatar",
  "description": "Round avatar with initials fallback and optional corner badge, plus a LogoTile for company logos.",
  "category": "Primitives",
  "version": "1.0.0",
  "dependencies": ["lucide-react"],
  "files": ["components/crm/avatar.tsx"],
  "examples": [
    {
      "title": "Default",
      "file": "avatar-1.tsx"
    }
  ],
  "props": [
    {
      "name": "name",
      "type": "string",
      "description": "Used for alt text and initials",
      "required": true
    },
    {
      "name": "src",
      "type": "string",
      "description": "Image URL",
      "required": false
    },
    {
      "name": "size",
      "type": "\"xs\" | \"sm\" | \"md\" | \"lg\"",
      "description": "Diameter",
      "default": "\"sm\"",
      "required": false
    },
    {
      "name": "badge",
      "type": "ReactNode",
      "description": "Small node in the bottom-right corner",
      "required": false
    }
  ],
  "usage": ""
}
