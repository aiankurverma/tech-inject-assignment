# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/techinject
PUBLIC_ORIGIN=http://localhost:4000
PREVIEW_ORIGIN=http://localhost:5185
TRUSTED_ORIGINS=http://localhost:5183,http://localhost:5184
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars-or-more
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Test accounts created by `npm run seed`
SEED_FREE_EMAIL=free@example.com
SEED_FREE_PASSWORD=change-me-free-password

# Frontend build-time settings
VITE_PREVIEW_ORIGIN=http://localhost:5185
# Where the admin's "Page builder" link points. Empty = same origin as the admin (production).
VITE_WEB_ORIGIN=http://localhost:5183

# AI draft builder (feature-radar). Leave all keys empty to disable.
# Primary provider: anthropic (uses ANTHROPIC_API_KEY), gemini (uses GEMINI_API_KEY)
# or inception (uses INCEPTION_API_KEY).
AI_PROVIDER=anthropic
# Anthropic API key, used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Google Gemini API key, used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Primary model; use a Gemini model (e.g. gemini-2.5-flash) when AI_PROVIDER=gemini.
# Ignored when AI_PROVIDER=inception (see INCEPTION_MODEL).
FEATURE_BUILDER_MODEL=claude-sonnet-5
# Inception (Mercury) API key. Primary when AI_PROVIDER=inception, otherwise the first fallback.
INCEPTION_API_KEY=
# Inception model (default mercury-2.5).
INCEPTION_MODEL=mercury-2.5
# Seconds an identical AI request is answered from cache instead of the provider (0 = off).
AI_CACHE_TTL_SECONDS=600
# Fallback: OpenRouter keys, comma separated, tried in order when the primary fails.
OPENROUTER_API_KEYS=
# Model used with every OpenRouter fallback key.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Last fallback: Ollama Cloud API key (empty = skip).
OLLAMA_CLOUD_KEY=
# Model used with the Ollama Cloud fallback.
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# Redis (optional). Unset = in-memory cache, rate limits and queue (fine for one instance).
REDIS_URL=
# Bundle uploads bigger than this (bytes) are validated and saved by a background job.
QUEUE_THRESHOLD_BYTES=200000
# Optional: ping /api/health every N minutes (1-14) so a free Render instance does not sleep. Empty = off.
KEEP_ALIVE_MINUTES=
